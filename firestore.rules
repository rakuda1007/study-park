rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPublishedContent() {
      return resource.data.status == 'published';
    }

    function isWorkspaceOwner(wsId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/workspaces/$(wsId)).data.ownerId == request.auth.uid;
    }

    function isWorkspaceMember(wsId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/workspaceMembers/$(wsId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/workspaceMembers/$(wsId + '_' + request.auth.uid)).data.status == 'active';
    }

    function canAccessWorkspace(wsId) {
      return isAdmin() || isWorkspaceOwner(wsId) || isWorkspaceMember(wsId);
    }

    function isCreatorWithPurchase() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appPurchase.status == 'active';
    }

    function isPublicVisibility() {
      return resource.data.visibility == 'unlisted' || resource.data.visibility == 'public';
    }

    function canReadWorkspaceContent(wsId) {
      return isAdmin()
        || isWorkspaceOwner(wsId)
        || (isWorkspaceMember(wsId) && isPublishedContent())
        || (isPublishedContent() && isPublicVisibility());
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 管理者ログインのアカウントロック（Cloud Functions / Admin SDK のみ更新）
    match /adminLoginLocks/{lockId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      // 学習者ホームの「提供：氏名」表示のため、ログイン済みユーザー同士の読み取りを許可
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role in ['creator', 'learner']
        && request.resource.data.appPurchase.status == 'none';
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.appPurchase == resource.data.appPurchase)
        || (isSignedIn()
          && request.auth.uid == uid
          && resource.data.role == 'learner'
          && request.resource.data.role == 'creator'
          && request.resource.data.appPurchase == resource.data.appPurchase
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']));
    }

    match /billingTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /workspaceAdFlags/{wsId} {
      allow read: if true;
      allow create, update: if isWorkspaceOwner(wsId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /workspaceSlugs/{slug} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceId is string;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /workspaceInviteCodes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /workspaces/{wsId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || isWorkspaceMember(wsId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.inviteCode is string;
      allow update: if isWorkspaceOwner(wsId) || isAdmin();
      allow delete: if isAdmin();

      match /contents/{contentId} {
        allow read: if canReadWorkspaceContent(wsId);
        allow create, update, delete: if isWorkspaceOwner(wsId) || isAdmin();
      }

      match /subjects/{subjectId} {
        allow read: if canAccessWorkspace(wsId);
        allow write: if isWorkspaceOwner(wsId) || isAdmin();
      }

      match /assets/{assetId} {
        allow read: if canAccessWorkspace(wsId);
        allow write: if false;
      }

      match /billingNotifications/{notificationId} {
        allow read: if isWorkspaceOwner(wsId) || isAdmin();
        allow write: if false;
      }
    }

    match /workspaceMembers/{memberId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || isWorkspaceOwner(resource.data.workspaceId)
          || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'learner'
        && request.resource.data.status == 'active'
        && memberId == request.resource.data.workspaceId + '_' + request.auth.uid;
      allow update: if isWorkspaceOwner(resource.data.workspaceId)
        || isAdmin()
        || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role == 'learner'
          && request.resource.data.status == 'active');
      allow delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contents/{contentId} {
      allow read: if isPublishedContent() || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /legacyContents/{legacyId} {
      allow read: if resource.data.ready == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /guestLearners/{guestId} {
      allow read: if isAdmin();
      allow create: if guestId.matches('^[a-zA-Z0-9_-]{8,64}$')
        && request.resource.data.keys().hasOnly(['firstSeenAt', 'lastSeenAt', 'visitCount', 'lastContentRef'])
        && request.resource.data.visitCount == 1;
      allow update: if guestId.matches('^[a-zA-Z0-9_-]{8,64}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'visitCount', 'lastContentRef'])
        && request.resource.data.visitCount >= resource.data.visitCount;
    }
  }
}
