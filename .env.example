# Firebase Web アプリ設定（Firebase Console の「プロジェクトの設定」>「マイアプリ」から取得）
# 値はコミットしないでください。コピーして .env.local を作成し、実値を入力します。
# 管理画面（/admin）には Authentication（メール/パスワード）と Firestore の admins/{uid} が必要です。
# 手順: docs/admin-setup.md

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics を使う場合のみ（未使用なら空のままでも可）
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe（将来の Checkout 用・未設定でもログイン/ワークスペースは利用可）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_CREATOR_PRICE_ID=
