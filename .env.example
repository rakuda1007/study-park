# 本番の公開 URL（招待リンク・Stripe 戻り先）
NEXT_PUBLIC_SITE_URL=https://study.tennis-community.com

# Firebase Web アプリ設定（Firebase Console の「プロジェクトの設定」>「マイアプリ」から取得）
# 値はコミットしないでください。コピーして .env.local を作成し、実値を入力します。
# 管理画面（/admin）には Authentication（メール/パスワード）と Firestore の admins/{uid} が必要です。
# 手順: docs/admin-setup.md

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics を使う場合のみ（未使用なら空のままでも可）
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Stripe（クライアント）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
# 互換
NEXT_PUBLIC_STRIPE_CREATOR_PRICE_ID=

# ローカル開発: Next.js API で Checkout（npm run dev 時 true 推奨）
NEXT_PUBLIC_BILLING_USE_API_ROUTES=true

# 本番: Cloud Functions のリージョン
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-northeast1

# Stripe・Webhook（サーバー専用・.env.local のみ。コミット禁止）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=

# ローカル Webhook / API で Firestore を更新する場合（サービスアカウント）
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 課金運用メール（Cloud Functions・未設定時はログのみ）
RESEND_API_KEY=
BILLING_MAIL_FROM=

# Google AdSense（お試し中のみ表示・未設定時は広告枠を出さない）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_CREATOR_EDIT=
NEXT_PUBLIC_ADSENSE_SLOT_QUIZ_FINISH=
